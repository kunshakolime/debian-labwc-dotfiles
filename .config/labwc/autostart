#!/bin/bash

# === What runs when labwc starts ===

# foot --server — terminal daemon (makes footclient launches instant)
foot --server &

# wallpaper — restores saved wallpaper and rotation from wallpaper.conf
"$HOME/.local/bin/wallpaper" --restore &

# waybar — the top/bottom status bar
waybar &

# dunst — notification daemon (volume popups, battery alerts, etc.)
dunst &

# cliphist — clipboard manager with history (press Super+V to browse)
wl-paste --watch cliphist store &

# lxpolkit — GUI sudo prompts (mounting drives, admin tools, etc.)
if command -v lxpolkit > /dev/null 2>&1; then
    lxpolkit &
fi

# nm-applet — wifi/network tray icon (NetworkManager)
if command -v nm-applet > /dev/null 2>&1; then
    nm-applet &
fi
