#!/bin/bash
# Network share manager — WebDAV, Samba (SMB), SFTP.
#
#   mount-net add <name>            — add a share (asks a few questions)
#   mount-net edit <name>           — change an existing share (url/server/credentials)
#   mount-net remove <name>         — forget a share (also clears its credentials)
#   mount-net status                — shares + mode (auto/keep) + mounted state
#   mount-net mount <name>          — mount now
#   mount-net umount <name>         — unmount now
#   mount-net auto <name>           — mount on access, unmount after idle (default)
#   mount-net keep <name>           — mount at boot, never auto-unmount
#
# Everything is written for you as systemd .mount/.automount units
# (/mnt/<name>); credentials are stored root-only. No config files to hand-edit.

set -e

UNIT_DIR=/etc/systemd/system
DAV_SECRETS=/etc/davfs2/secrets
CIFS_CRED_DIR=/etc/cifs-credentials
IDLE_SEC=300

unit()        { echo "mnt-$1"; }
mount_point() { echo "/mnt/$1"; }

valid_name() { [[ "$1" =~ ^[a-zA-Z0-9-]+$ ]]; }

bad_secret() {
    [[ "$1" =~ [[:space:]] ]] || [[ "$1" == *'"'* ]] || [[ "$1" == *'\'* ]] || [[ "$1" == *'#'* ]]
}

dav_secret_line() {
    if [ -n "$3" ]; then
        printf '%s %s %s\n' "$1" "$2" "$3"
    else
        printf '%s %s ""\n' "$1" "$2"
    fi
}

name_from_unit() {
    local base
    base="$(basename "$1" .mount)"
    echo "${base#mnt-}"
}

require_name() {
    [ -n "$1" ] || { echo "usage: mount-net $CMD <name>"; exit 1; }
    valid_name "$1" || { echo "invalid name (letters, digits, - only): $1"; exit 1; }
}

unit_key() {
    sed -n "s/^$1=//p" "$2"
}

try_mount() {
    local u what where fstype opts rc=0
    u="$(unit "$1")"
    what="$(unit_key What "$UNIT_DIR/$u.mount")"
    where="$(unit_key Where "$UNIT_DIR/$u.mount")"
    fstype="$(unit_key Type "$UNIT_DIR/$u.mount")"
    opts="$(unit_key Options "$UNIT_DIR/$u.mount")"
    echo "  running: mount $what $where -t $fstype -o $opts"
    sudo timeout 20 mount "$what" "$where" -t "$fstype" -o "$opts" < /dev/null 2>&1 || rc=$?
    if [ "$rc" = "124" ]; then
        echo "  (timed out after 20s — server not reachable)"
    fi
    return "$rc"
}

share_type() {
    sed -n 's/^Type=//p' "$UNIT_DIR/$(unit "$1").mount" 2>/dev/null || echo ""
}

write_units() {
    local name="$1" type="$2" what="$3" fstype="$4" opts="$5"
    sudo tee "$UNIT_DIR/$(unit "$name").mount" >/dev/null <<EOF
[Unit]
Description=$type network share $name

[Mount]
What=$what
Where=$(mount_point "$name")
Type=$fstype
Options=$opts

[Install]
WantedBy=multi-user.target
EOF
    sudo tee "$UNIT_DIR/$(unit "$name").automount" >/dev/null <<EOF
[Unit]
Description=$type network share $name (auto)

[Automount]
Where=$(mount_point "$name")
TimeoutIdleSec=$IDLE_SEC

[Install]
WantedBy=multi-user.target
EOF
}

switch_mode() {
    local name="$1" mode="$2" u
    u="$(unit "$name")"
    require_name "$name"
    case "$mode" in
        auto)
            sudo systemctl disable --now "$u.mount" 2>/dev/null || true
            sudo systemctl enable --now "$u.automount"
            ;;
        keep)
            sudo systemctl disable --now "$u.automount" 2>/dev/null || true
            if ! sudo systemctl enable --now "$u.mount" 2>&1; then
                echo "mount of '$name' failed — showing the real error:"
                try_mount "$name" || true
                exit 1
            fi
            ;;
        *)
            echo "mode must be 'auto' or 'keep'"
            exit 1
            ;;
    esac
    echo "'$name' -> $(mount_point "$name") is now $mode"
}

add() {
    local type="" name="" what="" fstype="" opts="" user="" pass=""
    printf 'Add network share\n'
    read -rp 'Type (webdav/smb/sftp) [webdav]: ' type
    type="${type:-webdav}"
    case "$type" in webdav|smb|sftp) ;; *) echo "unknown type: $type"; exit 1 ;; esac
    read -rp 'Name (short label, e.g. nas): ' name
    valid_name "$name" || { echo "invalid name (letters, digits, - only): $name"; exit 1; }
    [ ! -f "$UNIT_DIR/$(unit "$name").mount" ] || { echo "share '$name' already exists"; exit 1; }

    case "$type" in
        webdav)
            read -rp 'WebDAV URL (e.g. https://host/dav): ' what
            [ -n "$what" ] || { echo "URL required"; exit 1; }
            read -rp 'Username (blank = anonymous): ' user
            read -rsp 'Password (blank = none): ' pass; echo
            [ -n "$user" ] || user="anonymous"
            for v in "$what" "$user" "$pass"; do
                if bad_secret "$v"; then
                    echo "error: URL, username and password must not contain spaces, quotes, backslashes or # (davfs2 secrets format)"
                    exit 1
                fi
            done
            fstype="davfs"
            opts="uid=$(id -u),gid=$(id -g),_netdev"
            sudo tee -a "$DAV_SECRETS" >/dev/null <<EOF
$(dav_secret_line "$what" "$user" "$pass")
EOF
            sudo chmod 600 "$DAV_SECRETS"
            warn_bad_secrets
            ;;
        smb)
            local server share
            read -rp 'Server (host or IP): ' server
            read -rp 'Share name: ' share
            read -rp 'Username (blank = guest): ' user
            read -rsp 'Password (blank = none): ' pass; echo
            [ -n "$user" ] || user="guest"
            for v in "$server" "$share"; do
                if bad_secret "$v"; then
                    echo "error: server and share name must not contain spaces or special characters"
                    exit 1
                fi
            done
            what="//$server/$share"
            fstype="cifs"
            opts="credentials=$CIFS_CRED_DIR/$name,uid=$(id -u),gid=$(id -g),iocharset=utf8,_netdev"
            sudo install -d -m 700 "$CIFS_CRED_DIR"
            sudo tee "$CIFS_CRED_DIR/$name" >/dev/null <<EOF
username=$user
password=$pass
EOF
            sudo chmod 600 "$CIFS_CRED_DIR/$name"
            ;;
        sftp)
            local suser rpath
            read -rp 'User@Server (e.g. me@host): ' suser
            read -rp 'Remote path [/home]: ' rpath
            rpath="${rpath:-/home}"
            for v in "$suser" "$rpath"; do
                if bad_secret "$v"; then
                    echo "error: user@server and remote path must not contain spaces or special characters"
                    exit 1
                fi
            done
            what="$suser:$rpath"
            fstype="fuse.sshfs"
            opts="uid=$(id -u),gid=$(id -g),allow_other,_netdev"
            echo "Note: set up key login once with:  ssh-copy-id $suser"
            ;;
    esac

    write_units "$name" "$type" "$what" "$fstype" "$opts"
    sudo systemctl daemon-reload

    local mode
    read -rp 'Mode — auto (mount on access, unmount after idle) or keep (never auto-unmount)? [auto]: ' mode
    mode="${mode:-auto}"
    switch_mode "$name" "$mode"
    u="$(unit "$name")"
    if ! systemctl is-active --quiet "$u.mount" 2>/dev/null; then
        if ! sudo systemctl start "$u.mount" 2>&1; then
            echo
            echo "WARNING: '$name' is configured, but the first mount FAILED:"
            try_mount "$name" || true
            echo
            echo "It will retry when you access $(mount_point "$name")."
        fi
    fi
    echo "Added '$name' -> $(mount_point "$name")"
}

edit() {
    CMD=edit require_name "$1"
    local name="$1" u type kind was_mounted=no
    u="$(unit "$name")"
    [ -f "$UNIT_DIR/$u.mount" ] || { echo "no such share: $name"; exit 1; }
    type="$(share_type "$name")"
    case "$type" in
        davfs)      kind="webdav" ;;
        cifs)       kind="smb" ;;
        fuse.sshfs) kind="sftp" ;;
        *) echo "unknown share type: $type"; exit 1 ;;
    esac
    echo "Editing '$name' ($kind) -> $(mount_point "$name")"

    if systemctl is-active --quiet "$u.mount" 2>/dev/null; then
        was_mounted=yes
        sudo systemctl stop "$u.mount" 2>/dev/null || true
    fi

    local what fstype opts user pass
    case "$kind" in
        webdav)
            local old_what old_user
            old_what="$(unit_key What "$UNIT_DIR/$u.mount")"
            read -rp "WebDAV URL [$old_what]: " what
            what="${what:-$old_what}"
            [ -n "$what" ] || { echo "URL required"; exit 1; }
            old_user="$(sudo awk -v url="$old_what" '$1==url {print $2; exit}' "$DAV_SECRETS" 2>/dev/null || true)"
            read -rp "Username [${old_user:-anonymous}]: " user
            if [ -z "$user" ]; then user="${old_user:-anonymous}"; fi
            read -rsp 'Password (blank = keep current): ' pass; echo
            if [ -z "$pass" ]; then
                pass="$(sudo awk -v url="$old_what" '$1==url {print $3; exit}' "$DAV_SECRETS" 2>/dev/null || true)"
                [ "$pass" = '""' ] && pass=""
            fi
            for v in "$what" "$user" "$pass"; do
                if bad_secret "$v"; then
                    echo "error: URL, username and password must not contain spaces, quotes, backslashes or # (davfs2 secrets format)"
                    exit 1
                fi
            done
            fstype="davfs"
            opts="uid=$(id -u),gid=$(id -g),_netdev"
            sudo awk -v url="$old_what" '$1 != url' "$DAV_SECRETS" | sudo tee "$DAV_SECRETS.tmp" >/dev/null
            sudo mv "$DAV_SECRETS.tmp" "$DAV_SECRETS"
            sudo tee -a "$DAV_SECRETS" >/dev/null <<EOF
$(dav_secret_line "$what" "$user" "$pass")
EOF
            sudo chmod 600 "$DAV_SECRETS"
            warn_bad_secrets
            ;;
        smb)
            local server share old_server old_share old_what old_user
            old_what="$(unit_key What "$UNIT_DIR/$u.mount")"
            old_rest="${old_what#//}"
            old_server="${old_rest%%/*}"
            old_share="${old_rest#*/}"
            read -rp "Server [$old_server]: " server
            server="${server:-$old_server}"
            read -rp "Share name [$old_share]: " share
            share="${share:-$old_share}"
            [ -n "$server" ] && [ -n "$share" ] || { echo "server and share name required"; exit 1; }
            old_user="$(sudo sed -n 's/^username=//p' "$CIFS_CRED_DIR/$name" 2>/dev/null || true)"
            read -rp "Username [${old_user:-guest}]: " user
            if [ -z "$user" ]; then user="${old_user:-guest}"; fi
            read -rsp 'Password (blank = keep current): ' pass; echo
            if [ -z "$pass" ]; then
                pass="$(sudo sed -n 's/^password=//p' "$CIFS_CRED_DIR/$name" 2>/dev/null || true)"
            fi
            for v in "$server" "$share"; do
                if bad_secret "$v"; then
                    echo "error: server and share name must not contain spaces or special characters"
                    exit 1
                fi
            done
            what="//$server/$share"
            fstype="cifs"
            opts="credentials=$CIFS_CRED_DIR/$name,uid=$(id -u),gid=$(id -g),iocharset=utf8,_netdev"
            sudo tee "$CIFS_CRED_DIR/$name" >/dev/null <<EOF
username=$user
password=$pass
EOF
            sudo chmod 600 "$CIFS_CRED_DIR/$name"
            ;;
        sftp)
            local suser rpath old_what old_suser old_rpath
            old_what="$(unit_key What "$UNIT_DIR/$u.mount")"
            old_suser="${old_what%%:*}"
            old_rpath="${old_what#*:}"
            read -rp "User@Server [$old_suser]: " suser
            suser="${suser:-$old_suser}"
            read -rp "Remote path [$old_rpath]: " rpath
            rpath="${rpath:-$old_rpath}"
            for v in "$suser" "$rpath"; do
                if bad_secret "$v"; then
                    echo "error: user@server and remote path must not contain spaces or special characters"
                    exit 1
                fi
            done
            what="$suser:$rpath"
            fstype="fuse.sshfs"
            opts="uid=$(id -u),gid=$(id -g),allow_other,_netdev"
            ;;
        *)
            echo "unknown share type: $type"; exit 1
            ;;
    esac

    write_units "$name" "$kind" "$what" "$fstype" "$opts"
    sudo systemctl daemon-reload

    local mode
    if systemctl is-enabled --quiet "$u.automount" 2>/dev/null; then mode="auto"
    elif systemctl is-enabled --quiet "$u.mount" 2>/dev/null; then mode="keep"
    else mode="auto"; fi
    switch_mode "$name" "$mode"

    if [ "$was_mounted" = yes ]; then
        if ! sudo systemctl start "$u.mount" 2>&1; then
            echo "updated, but remount FAILED:"
            try_mount "$name" || true
            exit 1
        fi
        echo "Updated '$name' (remounted at $(mount_point "$name"))"
    else
        echo "Updated '$name' -> $(mount_point "$name")"
    fi
}

remove_share() {
    CMD=remove require_name "$1"
    local name="$1" u type what
    u="$(unit "$name")"
    type="$(share_type "$name")"
    what="$(unit_key What "$UNIT_DIR/$u.mount")"
    sudo systemctl disable --now "$u.automount" "$u.mount" 2>/dev/null || true
    sudo rm -f "$UNIT_DIR/$u.automount" "$UNIT_DIR/$u.mount"
    sudo systemctl daemon-reload
    sudo rm -f "$CIFS_CRED_DIR/$name"
    if [ "$type" = "davfs" ] && [ -n "$what" ] && [ -f "$DAV_SECRETS" ]; then
        sudo awk -v url="$what" '$1 != url' "$DAV_SECRETS" | sudo tee "$DAV_SECRETS.tmp" >/dev/null
        sudo mv "$DAV_SECRETS.tmp" "$DAV_SECRETS"
        sudo chmod 600 "$DAV_SECRETS"
    fi
    echo "Removed '$name'"
}

status() {
    shopt -s nullglob
    local f name u type mode a m st state failed=()
    for f in "$UNIT_DIR"/mnt-*.mount; do
        name="$(name_from_unit "$f")"
        u="$(unit "$name")"
        type="$(share_type "$name")"
        a="$(systemctl is-enabled "$u.automount" 2>/dev/null || true)"
        m="$(systemctl is-enabled "$u.mount" 2>/dev/null || true)"
        if [ "$a" = "enabled" ]; then mode="auto"
        elif [ "$m" = "enabled" ]; then mode="keep"
        else mode="off"; fi
        st="$(systemctl is-active "$u.mount" 2>/dev/null || true)"
        case "$st" in
            active) state="mounted" ;;
            failed) state="FAILED"; failed+=("$name") ;;
            *)      state="unmounted" ;;
        esac
        printf '%-15s %-6s %-8s %s\n' "$name" "$mode" "$type" "$state"
    done
    if [ ${#failed[@]} -gt 0 ]; then
        echo
        echo "FAILED shares — see why with: mount-net mount <name>"
    fi
    shopt -u nullglob
}

warn_bad_secrets() {
    [ -f "$DAV_SECRETS" ] || return 0
    local bad
    bad="$(sudo awk 'NF>0 && $0 !~ /^#/ && (NF<2 || NF>3) { print NR }' "$DAV_SECRETS" 2>/dev/null || true)"
    if [ -n "$bad" ]; then
        echo "WARNING: malformed line(s) $bad in $DAV_SECRETS"
    fi
}

CMD="${1:-}"
case "$CMD" in
    add)   shift; add "$@" ;;
    edit)  shift; edit "$@" ;;
    remove) shift; remove_share "$@" ;;
    status) status ;;
    mount) shift; CMD=mount require_name "$1"
        u="$(unit "$1")"
        if ! sudo systemctl start "$u.mount" 2>&1; then
            echo "systemd failed to mount '$1' — showing the real error:"
            try_mount "$1"
            exit 1
        fi
        echo "'$1' mounted at $(mount_point "$1")"
        ;;
    umount|unmount) shift; CMD=umount require_name "$1"; sudo systemctl stop "$(unit "$1").mount" ;;
    auto)  shift; CMD=auto require_name "$1"; switch_mode "$1" auto ;;
    keep)  shift; CMD=keep require_name "$1"; switch_mode "$1" keep ;;
    *)
        echo "usage: mount-net {add|edit|remove|status|mount|umount|auto|keep} [name]"
        exit 1
        ;;
esac
