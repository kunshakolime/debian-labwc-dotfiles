#!/bin/bash
# Night light: warm (fixed, remembered temperature), auto (follows the sun),
# or off. The waybar widget clicks cycle modes; Super+F9/F10 fine-tune warmth.
# gammastep always runs detached, so every command returns instantly — no hung
# invocations, no late/stale notifications. The saved state is restored
# silently at login (autostart runs `nightlight restore`). `status` reflects
# what's actually on screen, not just the state file.
# Notifies like volume/brightness.

STATE="$HOME/.local/state/nightlight"
STEP="${2:-250}"
LAT=52.5
LON=13.4
DEFAULT_TEMP=4500

mode=off
temp="$DEFAULT_TEMP"

read_state() {
    [ -f "$STATE" ] || return
    read -r _mode _temp < "$STATE" 2>/dev/null
    [ -n "$_mode" ] && mode="$_mode"
    [ -n "$_temp" ] && temp="$_temp"
}

write_state() {
    mkdir -p "$(dirname "$STATE")"
    printf '%s %s\n' "$mode" "$temp" > "$STATE"
}

running() {
    pgrep -x gammastep >/dev/null 2>&1
}

apply() {
    pkill -x gammastep 2>/dev/null
    case "$mode" in
        warm) gammastep -O "$temp" -r >/dev/null 2>&1 & ;;
        auto) gammastep -l "$LAT:$LON" >/dev/null 2>&1 & ;;
        # off: no daemon; wlr-gamma-control resets to neutral when ours dies
    esac
}

notify() {
    case "$mode" in
        warm)
            pct=$(( (6500 - temp) * 100 / 3500 ))
            dunstify -h string:x-dunst-stack-tag:nightlight \
                -h int:value:"$pct" -a "night light" -u low \
                "Night light" "Warm ${temp}K"
            ;;
        auto)
            dunstify -h string:x-dunst-stack-tag:nightlight \
                -a "night light" -u low "Night light" "Auto (follows the sun)"
            ;;
        off)
            dunstify -h string:x-dunst-stack-tag:nightlight \
                -a "night light" -u low "Night light" "Off"
            ;;
    esac
}

case "${1:-toggle}" in
    status)
        read_state
        if [ "$mode" != off ] && ! running; then
            mode=off
        fi
        case "$mode" in
            warm) printf '{"text":"%s","tooltip":"Night light %sK","class":"on"}\n' "$(printf '\uf186')" "$temp" ;;
            auto) printf '{"text":"%s","tooltip":"Night light auto","class":"auto"}\n' "$(printf '\uf042')" ;;
            off)  printf '{"text":"%s","tooltip":"Night light off","class":"off"}\n' "$(printf '\uf185')" ;;
        esac
        exit 0
        ;;
    warm)
        read_state; mode=warm; temp="${2:-$temp}"
        [ "$temp" -gt 6500 ] && temp=6500
        [ "$temp" -lt 3000 ] && temp=3000
        write_state; apply; notify
        ;;
    off)
        read_state; mode=off; write_state; apply; notify
        ;;
    auto)
        read_state; mode=auto; write_state; apply; notify
        ;;
    warmer)
        read_state; mode=warm; temp=$((temp - STEP)); [ "$temp" -lt 3000 ] && temp=3000
        write_state; apply; notify
        ;;
    cooler)
        read_state; mode=warm; temp=$((temp + STEP)); [ "$temp" -gt 6500 ] && temp=6500
        write_state; apply; notify
        ;;
    toggle)
        read_state
        case "$mode" in
            warm) mode=off ;;
            off)  mode=auto ;;
            *)    mode=warm ;;
        esac
        write_state; apply; notify
        ;;
    restore)
        read_state; apply
        ;;
    *)
        echo "usage: nightlight {status|toggle|warm [temp]|off|auto|warmer [step]|cooler [step]|restore}"
        exit 1
        ;;
esac
